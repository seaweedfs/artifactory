def remote_env_cmd(cmd):
    prefix = os.environ["RDMA_HW_SUITE_REMOTE_PATH_PREFIX"]
    return f"export PATH={shlex.quote(prefix)}:$PATH; {cmd}"


def ssh(host, cmd, log, timeout=None):
    return run(["ssh", "-o", "BatchMode=yes", host, remote_env_cmd(cmd)], log, timeout)


def capture(host, cmd, path, timeout=30):
    if host == "m01":
        argv = ["bash", "-lc", cmd]
    else:
        argv = ["ssh", "-o", "BatchMode=yes", host, cmd]
    try:
        out = subprocess.check_output(argv, stderr=subprocess.STDOUT, timeout=timeout, text=True)
    except subprocess.CalledProcessError as e:
        out = e.output + f"\nCOMMAND_EXIT={e.returncode}\n"
    except subprocess.TimeoutExpired as e:
        out = (e.output or "") + f"\nCOMMAND_TIMEOUT={timeout}\n"
    path.write_text(out)
    return hashlib.sha256(out.encode()).hexdigest()


def stable_resource_text(name, text):
    if name == "rdma-qp.txt":
        # The kernel GSI QP's sq-psn advances during normal traffic and is not a
        # leaked user resource. Keep the raw file, but compare a stable digest.
        return re.sub(r"(type GSI state RTS sq-psn )\d+", r"\1<ignored>", text)
    return text


def resource_dirty_reason(name, text):
    if name == "rdma-proc.txt" and text.strip():
        return "ibv_rc_pingpong process present before case"
    if name == "rdma-mr.txt" and text.strip():
        return "RDMA MR present before case"
    if name in ("rdma-qp.txt", "rdma-cq.txt", "rdma-pd.txt") and " pid " in f" {text} ":
        return f"user {name.removesuffix('.txt')} resource present before case"
    return None


def resource_snapshot(host, outdir, m02):
    outdir.mkdir(parents=True, exist_ok=True)
    cmds = {
        "rdma-link.txt": "rdma link",
        "rdma-qp.txt": "rdma res show qp",
        "rdma-cq.txt": "rdma res show cq",
        "rdma-mr.txt": "rdma res show mr",
        "rdma-pd.txt": "rdma res show pd",
        "rdma-proc.txt": "pgrep -ax ibv_rc_pingpong || true",
    }
    hashes = {}
    for name, cmd in cmds.items():
        path = outdir / name
        capture("m01" if host == "m01" else m02, cmd, path)
        text = path.read_text(errors="replace")
        digest = hashlib.sha256(stable_resource_text(name, text).encode()).hexdigest()
        hashes[name] = {
            "sha256": digest,
            "ok": "COMMAND_EXIT=" not in text and "COMMAND_TIMEOUT=" not in text,
            "dirty_reason": resource_dirty_reason(name, text),
        }
    return hashes


class SuiteStepError(Exception):
    def __init__(self, item, reason):
        super().__init__(reason)
        self.item = item
        self.reason = reason


def checked(argv, log, timeout=None, cwd=None, env=None, item="staging_command"):
    rc, elapsed = run(argv, log, timeout, cwd, env)
    if rc != 0:
        raise SuiteStepError(item, f"command failed rc={rc}: {' '.join(map(str, argv))}; see {log}")
    return elapsed


def stage_mono(args, result_dir):
    src = pathlib.Path(args.workdir) / "seaweed-mono"
    src.parent.mkdir(parents=True, exist_ok=True)
    if not (src / ".git").exists():
        checked(["git", "clone", args.repo, str(src)], result_dir / "git-clone.log", 900, item="stage_git_clone")
    checked(["git", "-C", str(src), "fetch", "--all", "--prune"], result_dir / "git-fetch.log", 900, item="stage_git_fetch")
    checked(["git", "-C", str(src), "checkout", "--force", args.mono], result_dir / "git-checkout.log", 120, item="stage_git_checkout")
    got = subprocess.check_output(["git", "-C", str(src), "rev-parse", "HEAD"], text=True).strip()
    if got != args.mono:
        raise SuiteStepError("stage_git_checkout", f"mono checkout mismatch: got {got}, want {args.mono}")
    (src / "RDMA_HW_SUITE_SOURCE_SHA").write_text(args.mono + "\n")
    m02_src = f"{args.m02_workdir.rstrip('/')}/seaweed-mono-{args.mono[:8]}"
    checked(["ssh", "-o", "BatchMode=yes", args.m02, f"rm -rf {shlex.quote(m02_src)} && mkdir -p {shlex.quote(m02_src)}"], result_dir / "m02-mkdir.log", 120, item="stage_m02_mkdir")
    checked(["rsync", "-a", "--delete", "--exclude", "target", f"{src}/", f"{args.m02}:{m02_src}/"], result_dir / "m02-rsync.log", 900, item="stage_m02_rsync")
    marker = subprocess.check_output(["ssh", "-o", "BatchMode=yes", args.m02, f"cat {shlex.quote(m02_src)}/RDMA_HW_SUITE_SOURCE_SHA"], text=True).strip()
    if marker != args.mono:
        raise SuiteStepError("stage_m02_marker", f"M02 staged source mismatch: got {marker}, want {args.mono}")
    return str(src), m02_src


