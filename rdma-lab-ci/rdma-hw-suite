def snapshot_hosts(cid, host, cdir, args, when):
    hosts = ("m01", "m02") if cid == "unified.short_rc_dc" else (host,)
    return {name: resource_snapshot(name, cdir / f"resources-{when}" / name, args.m02) for name in hosts}


def snapshots_ok(snapshot):
    return all(entry["ok"] for host in snapshot.values() for entry in host.values())


def lab_dirty_reasons(snapshot):
    reasons = []
    for host, resources in snapshot.items():
        for name, entry in resources.items():
            if entry.get("dirty_reason"):
                reasons.append(f"{host}/{name}: {entry['dirty_reason']}")
    return reasons


def nested_t3_result(path, case_dir):
    try:
        nested = json.loads(path.read_text())
        status = nested.get("manifest", {}).get("status")
        runner_exit = nested.get("runner_exit")
        evidence_dir = case_dir / "nested-testops"
        evidence_dir.mkdir(parents=True, exist_ok=True)
        bundled = evidence_dir / "complete.json"
        bundled.write_bytes(path.read_bytes())
        result = {"live_result": str(path), "bundle_result": str(bundled), "bundle_sha256": sha256(bundled), "runner_exit": runner_exit, "status": status}
        return result, runner_exit == 0 and str(status).upper() == "PASS"
    except (OSError, ValueError, TypeError) as e:
        return {"result": str(path), "error": str(e)}, False


def path_is_within(path, root):
    try:
        pathlib.Path(path).resolve().relative_to(pathlib.Path(root).resolve())
        return True
    except ValueError:
        return False


def mount_info(path):
    probe = pathlib.Path(path)
    while not probe.exists() and probe != probe.parent:
        probe = probe.parent
    result = subprocess.run(
        ["findmnt", "-n", "-T", str(probe), "-o", "TARGET,FSTYPE"],
        text=True, capture_output=True,
    )
    if result.returncode != 0 or len(result.stdout.split()) < 2:
        raise SuiteStepError("t3_result_parent", f"cannot determine filesystem for {path}: {result.stderr.strip()}")
    return result.stdout.split()[:2]


def t3_result_parent_error(value, fs_type, share_mount):
    parent = pathlib.PurePosixPath(value)
    if not parent.is_absolute():
        return "must be an absolute M01-local path outside the result share"
    if fs_type.lower() in {"cifs", "smb", "smb3"} or path_is_within(value, share_mount):
        return "must be on an M01-local filesystem, never the SMB result share"
    if not any(path_is_within(value, root) for root in ("/tmp", "/opt/work", "/data/nvme")):
        return "must be below the T3 gate allow-list: /tmp, /opt/work, or /data/nvme"
    return None


def t3_result_self_test():
    assert t3_result_parent_error("/opt/work/rdma-lab-ci/t3-results", "ext4", "/mnt/smb") is None
    assert t3_result_parent_error("/opt/rdma-lab-ci/work/t3-results", "ext4", "/mnt/smb")
    assert t3_result_parent_error("/mnt/smb/work/share/testops/results", "cifs", "/mnt/smb")
    assert t3_result_parent_error("/mnt/smb/other", "ext4", "/mnt/smb")
    root = pathlib.Path(tempfile.mkdtemp())
    live = root / "live" / "complete.json"
    live.parent.mkdir(parents=True)
    live.write_text(json.dumps({"runner_exit": 0, "manifest": {"status": "PASS"}}) + "\n")
    result, passed = nested_t3_result(live, root / "bundle")
    assert passed and pathlib.Path(result["bundle_result"]).is_file()
    assert result["bundle_sha256"] == sha256(result["bundle_result"])
    shutil.rmtree(root)
    print("HW_SUITE_T3_LOCAL_RESULT_SELF_TEST PASS")


def run_case(case, args, ctx, result_dir):
    cid, host, timeout, tmpl = case
    cdir = result_dir / "cases" / cid.replace(".", "_")
    cdir.mkdir(parents=True, exist_ok=True)
    before = snapshot_hosts(cid, host, cdir, args, "before")
    dirty_reasons = lab_dirty_reasons(before)
    cmd = tmpl.format(**ctx, case_dir=str(cdir))
    log = cdir / "case.log"
    if dirty_reasons:
        row = {
            "case_id": cid,
            "verdict": "infra",
            "rc": 125,
            "counters": {"resource_baseline_returned": False, "resource_baseline_gated": False},
            "bytes_verified": None,
            "mismatches": None,
            "elapsed_s": 0.0,
            "product_sha": args.mono,
            "runner_sha": args.runner_sha,
            "log": str(log),
            "resources_before": before,
            "resources_after": before,
            "command": cmd,
            "infra_error": "lab not clean before case",
            "dirty_reasons": dirty_reasons,
        }
        log.write_text("INFRA_ERROR: lab not clean before case\n" + "\n".join(dirty_reasons) + "\n")
        (cdir / "verdict.json").write_text(json.dumps(row, indent=2) + "\n")
        return row
    if host == "m02":
        rc, elapsed = ssh(args.m02, cmd, log, timeout)
    else:
        env = lab_env()
        if cid == "t3.stale_key":
            pathlib.Path(args.t3_result_parent).mkdir(parents=True, exist_ok=True)
            env.update(ctx["t3_env"])
        rc, elapsed = shell(cmd, log, timeout, env=env)
    after = snapshot_hosts(cid, host, cdir, args, "after")
    baseline_returned = before == after and snapshots_ok(before) and snapshots_ok(after)
    if rc in (126, 127):
        verdict = "infra"
        stop_reason = f"command bootstrap failed rc={rc}"
    else:
        verdict = "pass" if rc == 0 else "fail"
        stop_reason = None
    row = {
        "case_id": cid,
        "verdict": verdict,
        "rc": rc,
        "counters": {"resource_baseline_returned": baseline_returned, "resource_baseline_gated": False},
        "bytes_verified": None,
        "mismatches": None,
        "elapsed_s": round(elapsed, 3),
        "product_sha": args.mono,
        "runner_sha": args.runner_sha,
        "log": str(log),
        "resources_before": before,
        "resources_after": after,
        "command": cmd,
    }
    if cid == "t3.stale_key":
        nested_path = pathlib.Path(ctx["t3_env"]["T3_RESULT_PARENT"]) / ctx["t3_env"]["T3_RESULT_TAG"] / "complete.json"
        row["nested_testops"], nested_ok = nested_t3_result(nested_path, cdir)
        if not nested_ok and row["verdict"] != "infra":
            row["verdict"] = "fail"
            if row["rc"] == 0:
                row["rc"] = 1
    if stop_reason:
        row["infra_error"] = stop_reason
    (cdir / "verdict.json").write_text(json.dumps(row, indent=2) + "\n")
    return row


@contextlib.contextmanager
def lab_lock(args):
    if fcntl is None:
        raise SystemExit("rdma-hw-suite requires fcntl on the lab host")
    with open(args.lock, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(lock, fcntl.LOCK_UN)


def required(name, value):
    if not value:
        raise SystemExit(f"{name} is required; set the matching RDMA_HW_SUITE_* env var or pass the CLI flag")
    return value


