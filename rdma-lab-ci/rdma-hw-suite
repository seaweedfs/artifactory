    ap.add_argument("--t3-gid-index", default=os.environ.get("RDMA_HW_SUITE_T3_GID_INDEX"))
    ap.add_argument("--t3-server-ip", default=os.environ.get("RDMA_HW_SUITE_T3_SERVER_IP"))
    ap.add_argument("--t3-server-ssh", default=os.environ.get("RDMA_HW_SUITE_T3_SERVER_SSH"))
    ap.add_argument("--t3-result-parent", default=os.environ.get("RDMA_HW_SUITE_T3_RESULT_PARENT"))
    ap.add_argument("--workdir", default="/opt/rdma-lab-ci/work")
    ap.add_argument("--m02-workdir", default="/opt/rdma-lab-ci/work")
    ap.add_argument("--results", default="/mnt/smb/work/share/testops/results/rdma-hw-suite")
    ap.add_argument("--lock", default=DEFAULT_LOCK)
    ap.add_argument("--activity", default=DEFAULT_ACTIVITY)
    ap.add_argument("--t3-step05-root", default=os.environ.get("HW_SUITE_T3_STEP05_ROOT", DEFAULT_T3_STEP05_ROOT))
    ap.add_argument("--preflight-negative-control", choices=["missing-t3-client", "missing-git-object", "missing-weed-uds", "missing-result-parent", "dirty-lab", "manifest-incomplete"], default=None, help="review control: remove one staged prerequisite before preflight")
    args = ap.parse_args()
    if not re.fullmatch(r"[0-9a-f]{40}", args.mono):
        raise SystemExit("--mono must be a 40-char sha")
    suite_dir = pathlib.Path(__file__).resolve().parent
    args.runner_sha = hashlib.sha256(pathlib.Path(__file__).read_bytes()).hexdigest()
    run_id = f"hw-suite-S-{args.mono[:8]}-{datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ')}"
    result_dir = pathlib.Path(args.results) / run_id
    result_dir.mkdir(parents=True, exist_ok=False)
    preflight = input_preflight(args, result_dir)
    if preflight:
        preflight_summary(result_dir, run_id, args, preflight)
        print(json.dumps({"run_id": run_id, "status": "infra", "preflight_status": "fail", "failed_item": preflight["failed_item"], "reason": preflight["reason"], "result_dir": str(result_dir)}, indent=2))
        return 1
    try:
        with lab_lock(args):
            with open(args.activity, "a") as a:
                a.write(f"START codex02 rdma-hw-suite tier=S mono={args.mono} run={run_id} {now()}\n")
            mono_src, m02_src = stage_mono(args, result_dir)
            bindir, t3_step05_root = build_suite_bins(mono_src, result_dir, args)

        provenance = json.loads((result_dir / "build-provenance.json").read_text())
        provenance["product_sha"] = args.mono
        weed_uds_path = pathlib.Path("/opt/work/weed-uds")
        weed_uds_path.parent.mkdir(parents=True, exist_ok=True)
        weed_bytes = (bindir / "weed").read_bytes()
        weed_uds_path.write_bytes(weed_bytes)
        weed_uds_path.chmod(0o755)
        provenance["unified_weed_path"] = str(weed_uds_path)
        provenance["unified_weed_sha256"] = hashlib.sha256(weed_bytes).hexdigest()
        checked(["ssh", "-o", "BatchMode=yes", args.m02, f"mkdir -p {shlex.quote(str(weed_uds_path.parent))}"], result_dir / "m02-weed-uds-mkdir.log", 120, item="stage_m02_weed_uds_mkdir")
        checked(["rsync", "-a", str(weed_uds_path), f"{args.m02}:{weed_uds_path}"], result_dir / "m02-weed-uds-rsync.log", 120, item="stage_m02_weed_uds_rsync")
        t3_volume_path = pathlib.Path("/opt/work/bin") / f"weed-volume-{args.mono}-rdma"
        t3_volume_path.parent.mkdir(parents=True, exist_ok=True)
        volume_bytes = (bindir / "weed-volume").read_bytes()
        t3_volume_path.write_bytes(volume_bytes)
        t3_volume_path.chmod(0o755)
        provenance["t3_volume_path"] = str(t3_volume_path)
        provenance["t3_volume_sha256"] = hashlib.sha256(volume_bytes).hexdigest()
        if args.preflight_negative_control == "missing-t3-client":
            target = pathlib.Path(t3_step05_root) / "tcp-client" / "t3-wire-client"
            if target.exists():
                target.unlink()
        (result_dir / "build-provenance.json").write_text(json.dumps(provenance, indent=2) + "\n")
        t3_env = {
            "SWEEP_PRODUCT": args.mono,
            "SWEEP_HARNESS": args.mono,
            "SWEEP_PRODUCT_TREE": mono_src,
            "SWEEP_HARNESS_TREE": mono_src,
            "SWEEP_ROOT": str(result_dir),
            "SWEEP_STEP05_ROOT": str(t3_step05_root),
            "T3_TAG": f"rdma-hw-suite-{run_id}-t3",
            "T3_RESULT_TAG": f"rdma-hw-suite-{run_id}-t3",
            "T3_RESULT_PARENT": args.t3_result_parent,
        }
        ctx = {"mono_src": mono_src, "m02_src": m02_src, "suite_dir": str(suite_dir), "repo": args.repo, "mono": args.mono, "rdma_ip": shlex.quote(args.rdma_ip), "t3_env": t3_env}
    except SuiteStepError as e:
        row = write_preflight(result_dir, {"preflight_status": "fail", "failed_item": e.item, "reason": e.reason, "manifest": {"product_sha": args.mono, "runner_sha": args.runner_sha}, "checks": [{"item": e.item, "ok": False, "reason": e.reason}]})
        preflight_summary(result_dir, run_id, args, row)
        print(json.dumps({"run_id": run_id, "status": "infra", "preflight_status": "fail", "failed_item": row["failed_item"], "reason": row["reason"], "result_dir": str(result_dir)}, indent=2))
        return 1
    except Exception as e:
        row = write_preflight(result_dir, {"preflight_status": "fail", "failed_item": "staging_exception", "reason": str(e), "manifest": {"product_sha": args.mono, "runner_sha": args.runner_sha}, "checks": [{"item": "staging_exception", "ok": False, "reason": str(e)}]})
        preflight_summary(result_dir, run_id, args, row)
        print(json.dumps({"run_id": run_id, "status": "infra", "preflight_status": "fail", "failed_item": row["failed_item"], "reason": row["reason"], "result_dir": str(result_dir)}, indent=2))
        return 1
    preflight = run_preflight(args, ctx, result_dir, bindir, t3_step05_root, weed_uds_path, t3_volume_path, provenance)
    if preflight["preflight_status"] != "pass":
        summary = {"run_id": run_id, "tier": args.tier, "status": "infra", "product_sha": args.mono, "runner_sha": args.runner_sha, "case_count": 0, "preflight_status": "fail", "failed_item": preflight["failed_item"], "reason": preflight["reason"], "cases": []}
        (result_dir / "summary.json").write_text(json.dumps(summary, indent=2) + "\n")
        with lab_lock(args):
            with open(args.activity, "a") as a:
                a.write(f"END codex02 rdma-hw-suite tier=S mono={args.mono} run={run_id} status=infra preflight_status=fail failed_item={preflight['failed_item']} {now()}\n")
        print(json.dumps({"run_id": run_id, "status": "infra", "preflight_status": "fail", "failed_item": preflight["failed_item"], "reason": preflight["reason"], "result_dir": str(result_dir)}, indent=2))
        return 1
    rows = []
    for case in CASES:
        if case[0] in SELF_LOCKING_CASES:
            row = run_case(case, args, ctx, result_dir)
        else:
            with lab_lock(args):
                row = run_case(case, args, ctx, result_dir)
        rows.append(row)
        if row["verdict"] == "infra":
            break
    status = "infra" if any(r["verdict"] == "infra" for r in rows) else ("pass" if all(r["verdict"] == "pass" for r in rows) else "fail")
    summary = {"run_id": run_id, "tier": args.tier, "status": status, "product_sha": args.mono, "runner_sha": args.runner_sha, "case_count": len(rows), "preflight_status": "pass", "failed_item": None, "reason": None, "cases": rows}
    (result_dir / "summary.json").write_text(json.dumps(summary, indent=2) + "\n")
    with lab_lock(args):
        with open(args.activity, "a") as a:
            a.write(f"END codex02 rdma-hw-suite tier=S mono={args.mono} run={run_id} status={status} {now()}\n")
    print(json.dumps({"run_id": run_id, "status": status, "result_dir": str(result_dir)}, indent=2))
    return 0 if status == "pass" else 1


if __name__ == "__main__":
    raise SystemExit(main())
