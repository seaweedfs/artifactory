def preflight_fail(item, reason):
    return {"preflight_status": "fail", "failed_item": item, "reason": reason}


def write_preflight(result_dir, row):
    (result_dir / "preflight.json").write_text(json.dumps(row, indent=2) + "\n"); return row


def preflight_summary(result_dir, run_id, args, row):
    summary = {"run_id": run_id, "tier": args.tier, "status": "infra", "product_sha": args.mono, "runner_sha": args.runner_sha, "case_count": 0, "preflight_status": "fail", "failed_item": row["failed_item"], "reason": row["reason"], "cases": []}
    (result_dir / "summary.json").write_text(json.dumps(summary, indent=2) + "\n"); return summary


def assert_file(item, path, executable=False):
    p = pathlib.Path(path)
    if not p.exists(): return preflight_fail(item, f"missing {p}")
    if not p.is_file(): return preflight_fail(item, f"not a file {p}")
    if executable and not os.access(p, os.X_OK): return preflight_fail(item, f"not executable {p}")
    return None


def remote_text(host, cmd, timeout=30):
    return subprocess.check_output(["ssh", "-o", "BatchMode=yes", host, cmd], stderr=subprocess.STDOUT, timeout=timeout, text=True).strip()


def require_manifest_details(manifest, paths):
    missing = []
    for dotted in paths:
        cur = manifest
        for part in dotted.split("."):
            if not isinstance(cur, dict) or part not in cur or cur[part] in (None, ""):
                missing.append(dotted)
                break
            cur = cur[part]
    return missing


def input_preflight(args, result_dir):
    checks, manifest = [], {"inputs": {}, "paths": {}}
    def ok(item, detail):
        checks.append({"item": item, "ok": True, "detail": detail})
    def fail(item, reason):
        checks.append({"item": item, "ok": False, "reason": reason})
        return write_preflight(result_dir, {"preflight_status": "fail", "failed_item": item, "reason": reason, "manifest": manifest, "checks": checks})
    required_inputs = (
        ("m02", args.m02), ("rdma_ip", args.rdma_ip), ("remote_path_prefix", os.environ.get("RDMA_HW_SUITE_REMOTE_PATH_PREFIX")),
        ("t3_client_host", args.t3_client_host), ("t3_client_user", args.t3_client_user), ("t3_client_key", args.t3_client_key),
        ("t3_rdma_device", args.t3_rdma_device), ("t3_gid_index", args.t3_gid_index), ("t3_result_parent", args.t3_result_parent),
    )
    for item, value in required_inputs:
        manifest["inputs"][item] = bool(value)
        if not value: return fail(item, "required value is empty")
        ok(item, str(value))
    args.t3_server_ip = args.t3_server_ip or args.rdma_ip
    args.t3_server_ssh = args.t3_server_ssh or args.m02
    key = pathlib.Path(args.t3_client_key)
    if not key.is_file(): return fail("t3_client_key", f"missing {key}")
    if not os.access(key, os.R_OK): return fail("t3_client_key", f"not readable {key}")
    ok("t3_client_key_readable", str(key))
    for item, path in (("result_root", pathlib.Path(args.results)), ("lab_lock_parent", pathlib.Path(args.lock).parent), ("activity_parent", pathlib.Path(args.activity).parent)):
        try:
            path.mkdir(parents=True, exist_ok=True)
            probe = path / f".rdma-hw-suite-preflight-{os.getpid()}"; probe.write_text("ok\n"); probe.unlink()
        except Exception as e:
            return fail(item, str(e))
        manifest["paths"][item] = str(path)
        ok(item, str(path))
    return None


def run_preflight(args, ctx, result_dir, bindir, t3_step05_root, weed_uds_path, t3_volume_path, provenance):
    log = []
    manifest = {"product_sha": args.mono, "runner_sha": args.runner_sha, "inputs": {}, "paths": {}, "tools": {}, "artifacts": {}, "t3": {}, "unified": {}, "negative_control": args.preflight_negative_control}
    def ok(item, detail):
        log.append({"item": item, "ok": True, "detail": detail})
    def fail(item, reason):
        row = preflight_fail(item, reason); log.append({"item": item, "ok": False, "reason": reason})
        row["manifest"] = manifest; row["checks"] = log; return write_preflight(result_dir, row)

    mono_src = pathlib.Path(ctx["mono_src"])
    m02_src = ctx["m02_src"]
    for item, value in (("m02", args.m02), ("rdma_ip", args.rdma_ip), ("remote_path_prefix", os.environ.get("RDMA_HW_SUITE_REMOTE_PATH_PREFIX")), ("t3_result_parent", args.t3_result_parent), ("t3_client_root", f"/tmp/seaweed-t3-client-rdma-hw-suite-*")):
        if not value: return fail(item, "required value is empty")
        manifest["inputs"][item] = str(value)
        ok(item, str(value))
    local_prefix = os.environ.get("RDMA_HW_SUITE_PATH_PREFIX", "")
    manifest["inputs"]["local_path_prefix"] = local_prefix
    ok("local_path_prefix", local_prefix or "<system PATH>")
    if not pathlib.Path(args.lock).parent.exists(): return fail("lab_lock", f"lock parent missing {pathlib.Path(args.lock).parent}")
    manifest["paths"]["lab_lock"] = args.lock
    ok("lab_lock", args.lock)
    if not pathlib.Path(args.activity).parent.exists(): return fail("activity_log", f"activity parent missing {pathlib.Path(args.activity).parent}")
    manifest["paths"]["activity_log"] = args.activity
    ok("activity_log", args.activity)
    try:
        probe = result_dir / f".writable-{os.getpid()}"; probe.write_text("ok\n"); probe.unlink()
    except Exception as e:
        return fail("result_root_writable", str(e))
    manifest["paths"]["result_root"] = str(result_dir)
    ok("result_root_writable", str(result_dir))
    for item in ("t3_client_host", "t3_client_user", "t3_client_key", "t3_rdma_device", "t3_gid_index", "t3_server_ip", "t3_server_ssh"):
        manifest["inputs"][item] = str(getattr(args, item))
    for name in ("git", "ssh", "rsync", "bash", "python3", "go", "cargo"):
        found = shutil.which(name)
        if not found: return fail(f"tool_{name}", "not found on local PATH")
        manifest["tools"][f"local_{name}"] = found
        ok(f"tool_{name}", found)
    try:
        remote_tools = remote_text(args.m02, remote_env_cmd("for t in git bash python3 cargo rustc rdma sha256sum; do command -v $t >/dev/null || { echo missing:$t; exit 9; }; done; echo ok"))
    except Exception as e:
        return fail("m02_tools", str(e))
    if remote_tools != "ok": return fail("m02_tools", remote_tools)
    manifest["tools"]["m02"] = "git,bash,python3,cargo,rustc,rdma,sha256sum"
    ok("m02_tools", "ok")
    for item, path in (("unified_script", pathlib.Path(ctx["suite_dir"]) / "run-mono-rdma-lab.sh"), ("object_bench_manifest", mono_src / "enterprise/rust/seaweedkv-tools/Cargo.toml")):
        err = assert_file(item, path)
        if err: return fail(err["failed_item"], err["reason"])
        manifest["unified"][item] = str(path)
        ok(item, str(path))
    manifest["unified"]["dc_env"] = {"ENABLE_DC": "1", "RDMA_PIPES": "4"}
    manifest["unified"]["evidence_export_root"] = str(result_dir)

    marker_path = mono_src / "RDMA_HW_SUITE_SOURCE_SHA"
    marker = marker_path.read_text().strip() if marker_path.exists() else ""
    manifest["paths"]["m01_source"] = {"path": str(mono_src), "marker_path": str(marker_path), "marker_sha256": sha256(marker_path) if marker_path.exists() else None}
    if marker != args.mono:
        return fail("m01_source_marker", f"got {marker!r}, want {args.mono}")
    ok("m01_source_marker", marker)
    try:
        want = "0" * 40 if args.preflight_negative_control == "missing-git-object" else args.mono
        subprocess.check_call(["git", "-C", str(mono_src), "cat-file", "-e", f"{want}^{{commit}}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except subprocess.CalledProcessError:
        return fail("m01_git_object", f"missing commit {want}")
    ok("m01_git_object", args.mono)
    try:
        remote_marker = remote_text(args.m02, f"cat {shlex.quote(m02_src)}/RDMA_HW_SUITE_SOURCE_SHA")
        remote_text(args.m02, f"git -C {shlex.quote(m02_src)} cat-file -e {shlex.quote(want)}^{{commit}}")
    except Exception as e:
        return fail("m02_staged_source", str(e))
    if remote_marker != args.mono:
        return fail("m02_source_marker", f"got {remote_marker!r}, want {args.mono}")
    try:
        m02_marker_sha = remote_text(args.m02, f"sha256sum {shlex.quote(m02_src)}/RDMA_HW_SUITE_SOURCE_SHA | awk '{{print $1}}'")
    except Exception as e:
        return fail("m02_source_marker_sha", str(e))
    manifest["paths"]["m02_source"] = {"path": m02_src, "marker_path": f"{m02_src}/RDMA_HW_SUITE_SOURCE_SHA", "marker_sha256": m02_marker_sha}
    ok("m02_staged_source", m02_src)

    for name in ("sw-test-runner", "weed", "weed-volume"):
        err = assert_file(f"bin_{name}", bindir / name, executable=True)
        if err: return fail(err["failed_item"], err["reason"])
        digest = sha256(bindir / name)
        if digest != provenance["binary_sha256"].get(name): return fail(f"bin_{name}", "sha256 does not match build provenance")
        manifest["artifacts"][name] = {"path": str(bindir / name), "sha256": digest}
        ok(f"bin_{name}", digest)
    for item, path, digest in (("m01_weed_uds", weed_uds_path, provenance.get("unified_weed_sha256")), ("t3_volume", t3_volume_path, provenance.get("t3_volume_sha256"))):
        err = assert_file(item, path, executable=True)
        if err: return fail(err["failed_item"], err["reason"])
        if sha256(path) != digest: return fail(item, "sha256 does not match provenance")
        manifest["artifacts"][item] = {"path": str(path), "sha256": digest}
        ok(item, str(path))
    try:
        m02_weed_sha = remote_text(args.m02, f"sha256sum {shlex.quote(str(weed_uds_path))} | awk '{{print $1}}'")
    except Exception as e:
        return fail("m02_weed_uds", str(e))
    if m02_weed_sha != provenance.get("unified_weed_sha256"):
        return fail("m02_weed_uds", "sha256 does not match provenance")
    manifest["artifacts"]["m02_weed_uds"] = {"path": str(weed_uds_path), "sha256": m02_weed_sha}
    ok("m02_weed_uds", m02_weed_sha)

    t3_cache = pathlib.Path(t3_step05_root) / "tcp-client"
    for name in ("t3-wire-client", "provenance.json"):
        err = assert_file(f"t3_cache_{name}", t3_cache / name, executable=(name == "t3-wire-client"))
        if err: return fail(err["failed_item"], err["reason"])
    if sha256(t3_cache / "t3-wire-client") != provenance["binary_sha256"].get("t3-wire-client"): return fail("t3_cache_t3-wire-client", "sha256 does not match build provenance")
    if args.preflight_negative_control == "missing-result-parent": return fail("t3_result_parent", "negative control removed result parent")
    pathlib.Path(args.t3_result_parent).mkdir(parents=True, exist_ok=True)
    try:
        t3_prov = json.loads((t3_cache / "provenance.json").read_text())
    except Exception as e:
        return fail("t3_cache_provenance", str(e))
    try:
        t3_bundle_cache = result_dir / "t3-step05" / "tcp-client"
        t3_bundle_cache.mkdir(parents=True, exist_ok=True)
        (t3_bundle_cache / "t3-wire-client").write_bytes((t3_cache / "t3-wire-client").read_bytes())
        (t3_bundle_cache / "provenance.json").write_bytes((t3_cache / "provenance.json").read_bytes())
    except Exception as e:
        return fail("t3_bundle_copy", str(e))
    manifest["t3"] = {"step05_root": str(t3_step05_root), "cache": str(t3_cache), "bundle_cache": str(t3_bundle_cache), "result_parent": args.t3_result_parent, "client_key": args.t3_client_key, "client_key_readable": os.access(args.t3_client_key, os.R_OK), "client_root": f"/tmp/seaweed-t3-client-rdma-hw-suite-*", "wire_client": {"path": str(t3_cache / "t3-wire-client"), "sha256": sha256(t3_cache / "t3-wire-client"), "bundle_path": str(t3_bundle_cache / "t3-wire-client"), "bundle_sha256": sha256(t3_bundle_cache / "t3-wire-client")}, "provenance": {"path": str(t3_cache / "provenance.json"), "sha256": sha256(t3_cache / "provenance.json"), "bundle_path": str(t3_bundle_cache / "provenance.json"), "bundle_sha256": sha256(t3_bundle_cache / "provenance.json"), "keys": sorted(t3_prov.keys())}}
    ok("t3_cache", str(t3_cache))
    ok("t3_result_parent", args.t3_result_parent)

    if args.preflight_negative_control == "missing-weed-uds": return fail("m01_weed_uds", "negative control removed weed-uds")
    if args.preflight_negative_control == "dirty-lab": return fail("clean_rdma_resources", "negative control injected dirty lab")
    before = {host: resource_snapshot(host, result_dir / "preflight-resources" / host, args.m02) for host in ("m01", "m02")}
    dirty = lab_dirty_reasons(before)
    if dirty: return fail("clean_rdma_resources", "; ".join(dirty))
    ok("clean_rdma_resources", "m01/m02")
    required_manifest = (
        "product_sha", "runner_sha", "inputs.m02", "inputs.rdma_ip", "inputs.remote_path_prefix", "inputs.local_path_prefix",
        "inputs.t3_result_parent", "inputs.t3_client_host", "inputs.t3_client_user", "inputs.t3_client_key", "inputs.t3_rdma_device", "inputs.t3_gid_index", "inputs.t3_server_ip", "inputs.t3_server_ssh",
        "paths.result_root", "paths.lab_lock", "paths.activity_log", "paths.m01_source.path", "paths.m01_source.marker_path", "paths.m01_source.marker_sha256", "paths.m02_source.path", "paths.m02_source.marker_path", "paths.m02_source.marker_sha256",
        "tools.local_git", "tools.local_ssh", "tools.local_rsync", "tools.local_bash", "tools.local_python3", "tools.local_go", "tools.local_cargo", "tools.m02",
        "artifacts.sw-test-runner.path", "artifacts.sw-test-runner.sha256", "artifacts.weed.path", "artifacts.weed.sha256", "artifacts.weed-volume.path", "artifacts.weed-volume.sha256", "artifacts.m01_weed_uds.path", "artifacts.m01_weed_uds.sha256", "artifacts.m02_weed_uds.path", "artifacts.m02_weed_uds.sha256", "artifacts.t3_volume.path", "artifacts.t3_volume.sha256",
        "t3.step05_root", "t3.cache", "t3.bundle_cache", "t3.result_parent", "t3.client_key", "t3.client_key_readable", "t3.client_root", "t3.wire_client.path", "t3.wire_client.sha256", "t3.wire_client.bundle_path", "t3.wire_client.bundle_sha256", "t3.provenance.path", "t3.provenance.sha256", "t3.provenance.bundle_path", "t3.provenance.bundle_sha256", "t3.provenance.keys",
        "unified.unified_script", "unified.object_bench_manifest", "unified.dc_env", "unified.evidence_export_root", "negative_control",
    )
    if args.preflight_negative_control == "manifest-incomplete": manifest["artifacts"]["m02_weed_uds"].pop("sha256", None)
    missing = require_manifest_details(manifest, required_manifest)
    if missing: return fail("manifest_completeness", "missing manifest details: " + ",".join(missing))
    row = {"preflight_status": "pass", "failed_item": None, "reason": None, "manifest": manifest, "checks": log}
    return write_preflight(result_dir, row)

def snapshot_hosts(cid, host, cdir, args, when):
    hosts = ("m01", "m02") if cid == "unified.short_rc_dc" else (host,)
    return {name: resource_snapshot(name, cdir / f"resources-{when}" / name, args.m02) for name in hosts}


def snapshots_ok(snapshot):
    return all(entry["ok"] for host in snapshot.values() for entry in host.values())


def lab_dirty_reasons(snapshot):
    reasons = []
    for host, resources in snapshot.items():
        for name, entry in resources.items():
            if entry.get("dirty_reason"):
                reasons.append(f"{host}/{name}: {entry['dirty_reason']}")
    return reasons


def run_case(case, args, ctx, result_dir):
    cid, host, timeout, tmpl = case
    cdir = result_dir / "cases" / cid.replace(".", "_")
    cdir.mkdir(parents=True, exist_ok=True)
    before = snapshot_hosts(cid, host, cdir, args, "before")
    dirty_reasons = lab_dirty_reasons(before)
    cmd = tmpl.format(**ctx, case_dir=str(cdir))
    log = cdir / "case.log"
    if dirty_reasons:
        row = {
            "case_id": cid,
            "verdict": "infra",
            "rc": 125,
            "counters": {"resource_baseline_returned": False, "resource_baseline_gated": False},
            "bytes_verified": None,
            "mismatches": None,
            "elapsed_s": 0.0,
            "product_sha": args.mono,
            "runner_sha": args.runner_sha,
            "log": str(log),
            "resources_before": before,
            "resources_after": before,
            "command": cmd,
            "infra_error": "lab not clean before case",
            "dirty_reasons": dirty_reasons,
        }
        log.write_text("INFRA_ERROR: lab not clean before case\n" + "\n".join(dirty_reasons) + "\n")
        (cdir / "verdict.json").write_text(json.dumps(row, indent=2) + "\n")
        return row
    if host == "m02":
        rc, elapsed = ssh(args.m02, cmd, log, timeout)
    else:
        env = lab_env()
        if cid == "t3.stale_key":
            pathlib.Path(args.t3_result_parent).mkdir(parents=True, exist_ok=True)
            env.update(ctx["t3_env"])
        rc, elapsed = shell(cmd, log, timeout, env=env)
    after = snapshot_hosts(cid, host, cdir, args, "after")
    baseline_returned = before == after and snapshots_ok(before) and snapshots_ok(after)
    if rc in (126, 127):
        verdict = "infra"
        stop_reason = f"command bootstrap failed rc={rc}"
    else:
        verdict = "pass" if rc == 0 else "fail"
        stop_reason = None
    row = {
        "case_id": cid,
        "verdict": verdict,
        "rc": rc,
        "counters": {"resource_baseline_returned": baseline_returned, "resource_baseline_gated": False},
        "bytes_verified": None,
        "mismatches": None,
        "elapsed_s": round(elapsed, 3),
        "product_sha": args.mono,
        "runner_sha": args.runner_sha,
        "log": str(log),
        "resources_before": before,
        "resources_after": after,
        "command": cmd,
    }
    if stop_reason:
        row["infra_error"] = stop_reason
    (cdir / "verdict.json").write_text(json.dumps(row, indent=2) + "\n")
    return row


@contextlib.contextmanager
def lab_lock(args):
    if fcntl is None:
        raise SystemExit("rdma-hw-suite requires fcntl on the lab host")
    with open(args.lock, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(lock, fcntl.LOCK_UN)


def required(name, value):
    if not value:
        raise SystemExit(f"{name} is required; set the matching RDMA_HW_SUITE_* env var or pass the CLI flag")
    return value


def main():
    ap = argparse.ArgumentParser(prog="rdma-hw-suite")
    ap.add_argument("--tier", required=True, choices=["S"])
    ap.add_argument("--mono", required=True, help="40-char product sha")
    ap.add_argument("--repo", default=DEFAULT_REPO)
    ap.add_argument("--m02", default=os.environ.get("RDMA_HW_SUITE_M02"))
    ap.add_argument("--rdma-ip", default=os.environ.get("RDMA_HW_SUITE_RDMA_IP"))
