def assert_file(item, path, executable=False):
    p = pathlib.Path(path)
    if not p.exists(): return preflight_fail(item, f"missing {p}")
    if not p.is_file(): return preflight_fail(item, f"not a file {p}")
    if executable and not os.access(p, os.X_OK): return preflight_fail(item, f"not executable {p}")
    return None


def remote_text(host, cmd, timeout=30):
    return subprocess.check_output(["ssh", "-o", "BatchMode=yes", host, cmd], stderr=subprocess.STDOUT, timeout=timeout, text=True).strip()


def require_manifest_details(manifest, paths, nullable=()):
    nullable = set(nullable)
    missing = []
    for dotted in paths:
        cur = manifest
        for part in dotted.split("."):
            if not isinstance(cur, dict) or part not in cur or cur[part] == "" or (cur[part] is None and dotted not in nullable):
                missing.append(dotted)
                break
            cur = cur[part]
    return missing


def filesystem_probe(path):
    probe = pathlib.Path(path).resolve()
    while not probe.exists() and probe != probe.parent:
        probe = probe.parent
    return probe, shutil.disk_usage(probe).free


def remote_filesystem_free(host, path):
    if host is None:
        probe, free_bytes = filesystem_probe(path)
        return str(probe), free_bytes
    quoted = shlex.quote(str(path))
    command = (
        f"probe={quoted}; while [ ! -e \"$probe\" ] && [ \"$probe\" != / ]; do probe=$(dirname \"$probe\"); done; "
        "printf '%s ' \"$probe\"; df -PB1 --output=avail \"$probe\" | tail -n 1 | tr -d ' '"
    )
    output = remote_text(host, remote_env_cmd(command))
    probe, free_text = output.rsplit(" ", 1)
    return probe, int(free_text)


def required_git_objects(product_sha):
    return {
        case: tuple(product_sha if obj == "product" else obj for obj in objects)
        for case, objects in CASE_REQUIRED_GIT_OBJECTS.items()
    }


def git_object_exists(repo, obj):
    return subprocess.run(
        ["git", "-C", str(repo), "cat-file", "-e", f"{obj}^{{commit}}"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    ).returncode == 0


def remote_git_object_exists(host, repo, obj):
    if host is None:
        return git_object_exists(repo, obj)
    try:
        remote_text(host, f"git -C {shlex.quote(str(repo))} cat-file -e {shlex.quote(obj)}^{{commit}}")
        return True
    except Exception:
        return False


def preflight_self_test(mode):
    with tempfile.TemporaryDirectory() as td:
        fixture = pathlib.Path(td)
        if mode in ("root-space-ok", "workdir-space-ok"):
            local_probe, local_free = filesystem_probe(fixture)
            remote_probe, remote_free = remote_filesystem_free(None, fixture)
            assert local_probe == pathlib.Path(remote_probe)
            assert local_free > 0 and remote_free > 0
            assert local_free >= 1 and remote_free >= 1
            assert local_free < local_free + 1 and remote_free < remote_free + 1
            print(f"PREFLIGHT_SELF_TEST PASS {mode} real_probe=true still_threshold=1 moving_threshold=free_plus_one")
            return
        subprocess.check_call(["git", "init", "-q", str(fixture)])
        subprocess.check_call(["git", "-C", str(fixture), "config", "user.email", "preflight@example.invalid"])
        subprocess.check_call(["git", "-C", str(fixture), "config", "user.name", "preflight"])
        (fixture / "marker").write_text("ok\n")
        subprocess.check_call(["git", "-C", str(fixture), "add", "marker"])
        subprocess.check_call(["git", "-C", str(fixture), "commit", "-qm", "fixture"])
        commit = subprocess.check_output(["git", "-C", str(fixture), "rev-parse", "HEAD"], text=True).strip()
        missing = "0" * 40
        assert git_object_exists(fixture, commit) and remote_git_object_exists(None, fixture, commit)
        assert not git_object_exists(fixture, missing) and not remote_git_object_exists(None, fixture, missing)
        objects = required_git_objects(commit)
        assert set(objects) == {case[0] for case in CASES}
        assert MAIN_PLAN_OBJECT in objects["volume.main_plan_peer"]
        assert T3_DONOR_OBJECT in objects["t3.stale_key"]
        print("PREFLIGHT_SELF_TEST PASS git-objects-ok real_lookup=true missing_lookup=RED cases=12")


def input_preflight(args, result_dir):
    checks, manifest = [], {"inputs": {}, "paths": {}}
    def ok(item, detail):
        checks.append({"item": item, "ok": True, "detail": detail})
    def fail(item, reason):
        checks.append({"item": item, "ok": False, "reason": reason})
        return write_preflight(result_dir, {"preflight_status": "fail", "failed_item": item, "reason": reason, "manifest": manifest, "checks": checks})
    required_inputs = (
        ("m02", args.m02), ("rdma_ip", args.rdma_ip), ("remote_path_prefix", os.environ.get("RDMA_HW_SUITE_REMOTE_PATH_PREFIX")),
        ("t3_client_host", args.t3_client_host), ("t3_client_user", args.t3_client_user), ("t3_client_key", args.t3_client_key),
        ("t3_rdma_device", args.t3_rdma_device), ("t3_gid_index", args.t3_gid_index), ("t3_result_parent", args.t3_result_parent),
    )
    for item, value in required_inputs:
        manifest["inputs"][item] = bool(value)
        if not value: return fail(item, "required value is empty")
        ok(item, str(value))
    for item, local_path, remote_path, control in (
        ("root_free_space", "/", "/", "low-root-space"),
        ("workdir_free_space", args.workdir, args.m02_workdir, "low-workdir-space"),
    ):
        local_probe, local_free = filesystem_probe(local_path)
        if args.preflight_negative_control == control:
            local_free = MIN_PREFLIGHT_FREE_BYTES - 1
            remote_probe, remote_free = remote_path, MIN_PREFLIGHT_FREE_BYTES + 1
        else:
            try:
                remote_probe, remote_free = remote_filesystem_free(args.m02, remote_path)
            except Exception as e:
                return fail(item, f"cannot inspect M02 filesystem: {e}")
        manifest["paths"][item] = {
            "required_bytes": MIN_PREFLIGHT_FREE_BYTES,
            "m01": {"path": str(local_probe), "free_bytes": local_free},
            "m02": {"path": remote_probe, "free_bytes": remote_free},
        }
        for host, probe, free_bytes in (("m01", local_probe, local_free), ("m02", remote_probe, remote_free)):
            if free_bytes < MIN_PREFLIGHT_FREE_BYTES:
                return fail(item, f"host={host} filesystem={probe} free_bytes={free_bytes} required_bytes={MIN_PREFLIGHT_FREE_BYTES}")
        ok(item, f"m01={local_probe}:{local_free} m02={remote_probe}:{remote_free} required_bytes={MIN_PREFLIGHT_FREE_BYTES}")
    try:
        share_mount, _ = mount_info(args.results)
        _, result_parent_fs = mount_info(args.t3_result_parent)
    except SuiteStepError as e:
        return fail(e.item, e.reason)
    result_parent_error = t3_result_parent_error(args.t3_result_parent, result_parent_fs, share_mount)
    if result_parent_error:
        return fail("t3_result_parent", result_parent_error)
    args.t3_server_ip = args.t3_server_ip or args.rdma_ip
    args.t3_server_ssh = args.t3_server_ssh or args.m02
    key = pathlib.Path(args.t3_client_key)
    if not key.is_file(): return fail("t3_client_key", f"missing {key}")
    if not os.access(key, os.R_OK): return fail("t3_client_key", f"not readable {key}")
    ok("t3_client_key_readable", str(key))
    for item, path in (("result_root", pathlib.Path(args.results)), ("lab_lock_parent", pathlib.Path(args.lock).parent), ("activity_parent", pathlib.Path(args.activity).parent)):
        try:
            path.mkdir(parents=True, exist_ok=True)
            probe = path / f".rdma-hw-suite-preflight-{os.getpid()}"; probe.write_text("ok\n"); probe.unlink()
        except Exception as e:
            return fail(item, str(e))
        manifest["paths"][item] = str(path)
        ok(item, str(path))
    return None


def run_preflight(args, ctx, result_dir, bindir, t3_step05_root, weed_uds_path, t3_volume_path, provenance):
    log = []
    manifest = {"product_sha": args.mono, "runner_sha": args.runner_sha, "inputs": {}, "paths": {}, "tools": {}, "artifacts": {}, "t3": {}, "unified": {}, "negative_control": args.preflight_negative_control}
    def ok(item, detail):
        log.append({"item": item, "ok": True, "detail": detail})
    def fail(item, reason):
        row = preflight_fail(item, reason); log.append({"item": item, "ok": False, "reason": reason})
        row["manifest"] = manifest; row["checks"] = log; return write_preflight(result_dir, row)

    mono_src = pathlib.Path(ctx["mono_src"])
    m02_src = ctx["m02_src"]
    for item, value in (("m02", args.m02), ("rdma_ip", args.rdma_ip), ("remote_path_prefix", os.environ.get("RDMA_HW_SUITE_REMOTE_PATH_PREFIX")), ("t3_result_parent", args.t3_result_parent), ("t3_client_root", f"/tmp/seaweed-t3-client-rdma-hw-suite-*")):
        if not value: return fail(item, "required value is empty")
        manifest["inputs"][item] = str(value)
        ok(item, str(value))
    local_prefix = os.environ.get("RDMA_HW_SUITE_PATH_PREFIX", "")
    manifest["inputs"]["local_path_prefix"] = local_prefix
    ok("local_path_prefix", local_prefix or "<system PATH>")
    if not pathlib.Path(args.lock).parent.exists(): return fail("lab_lock", f"lock parent missing {pathlib.Path(args.lock).parent}")
    manifest["paths"]["lab_lock"] = args.lock
    ok("lab_lock", args.lock)
    if not pathlib.Path(args.activity).parent.exists(): return fail("activity_log", f"activity parent missing {pathlib.Path(args.activity).parent}")
    manifest["paths"]["activity_log"] = args.activity
    ok("activity_log", args.activity)
    try:
        probe = result_dir / f".writable-{os.getpid()}"; probe.write_text("ok\n"); probe.unlink()
    except Exception as e:
        return fail("result_root_writable", str(e))
